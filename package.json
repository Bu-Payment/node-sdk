{
  "name": "@bu-payment/node-sdk",
  "version": "0.0.0",
  "description": "Confidential BuPayment client for Node.js servers, signing every request with the versioned BuPayment HMAC protocol.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bu-Payment/node-sdk.git"
  },
  "homepage": "https://github.com/Bu-Payment/node-sdk#readme",
  "bugs": {
    "url": "https://github.com/Bu-Payment/node-sdk/issues"
  },
  "keywords": [
    "bupayment",
    "node",
    "payments",
    "hmac",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "!docs/superpowers",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.js": "./dist/browser-guard.js",
    "./dist/index.cjs": "./dist/browser-guard.cjs"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "bun pm pack --dry-run",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run consumer:check",
    "consumer:check": "node scripts/consumer-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "bun@1.3.14"
}
